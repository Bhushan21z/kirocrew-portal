# Copy to .env and fill in every REPLACE_ME value:   cp .env.example .env
# Values must not contain spaces or quotes.

# --- Required ---------------------------------------------------------------

# Public hostname you route through your Cloudflare tunnel.
DOMAIN=crew.example.com

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application). Authorized redirect URI must be
# exactly: https://<DOMAIN>/oauth2/callback
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Random 32-byte secret that signs the oauth2-proxy login cookie. Generate:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=REPLACE_ME

# Token of YOUR Cloudflare tunnel (Zero Trust > Networks > Tunnels > your
# tunnel > Install connector; the long string after `--token`).
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Google accounts allowed in, comma-separated. setup.sh writes these to
# authenticated-emails.txt. Anyone not listed is refused before reaching
# Kiro Crew.
ALLOWED_EMAILS=you@gmail.com,teammate@example.com

# --- Optional (defaults shown) ---------------------------------------------

# Port your Kiro Crew gateway listens on (`kirocrew status` shows it).
KIROCREW_PORT=5476

# Port the kc-auth token API listens on (loopback only).
KC_AUTH_PORT=3000

# Lifetime of each token kc-auth mints, passed to `kirocrew token --ttl`.
TOKEN_TTL=8h

# Path to the kirocrew binary. Leave empty to use `command -v kirocrew`.
KIROCREW_BIN=

# oauth2-proxy login cookie lifetime and refresh interval.
OAUTH2_COOKIE_EXPIRE=168h
OAUTH2_COOKIE_REFRESH=1h

# macOS only: setup.sh appends this line on a Mac so every `docker compose`
# command here also uses the Mac override. Leave it unset on Linux.
# COMPOSE_FILE=docker-compose.yml:docker-compose.mac.yml
